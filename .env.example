# ==========================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN LMS TRƯỜNG HỌC
# ==========================================

# 1. ỨNG DỤNG BACKEND (API - NESTJS)
PORT=4000
NODE_ENV=development
API_TIEN_TO=/api/v1
URL_MAY_CHU=http://localhost:4000
URL_UNG_DUNG_WEB=http://localhost:3000

# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (PGVECTOR)
CSDL_NGUOI_DUNG=postgres
CSDL_MAT_KHAU=postgres
CSDL_TEN=lms_truong_hoc
CSDL_HOST=localhost
CSDL_CONG=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_truong_hoc?schema=public

# 3. REDIS (CACHE & BULLMQ)
REDIS_HOST=localhost
REDIS_CONG=6379
REDIS_MAT_KHAU=redis_matkhau_123

# 4. BẢO MẬT & XÁC THỰC JWT
JWT_ACCESS_SECRET=chuoi_bi_mat_access_token_lms_sieu_bao_mat_2026_xyz
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=chuoi_bi_mat_refresh_token_lms_sieu_bao_mat_2026_abc
JWT_REFRESH_EXPIRATION=7d

# 5. DỊCH VỤ LƯU TRỮ MINIO (S3 COMPATIBLE)
MINIO_ENDPOINT=localhost
MINIO_CONG_API=9000
MINIO_CONG_DIEU_KHIEN=9001
MINIO_KHOA_TRUY_CAP=minioadmin
MINIO_KHOA_BI_MAT=minioadmin
MINIO_BUCKET_MAC_DINH=lms-tai-lieu
MINIO_USE_SSL=false

# 6. HẠ TẦNG PHÒNG HỌC TRỰC TUYẾN LIVEKIT
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_key_livekit_lms_2026

# 7. TRỢ LÝ AI (GOOGLE GEMINI API)
GEMINI_API_KEY=api_key_gemini_cua_ban
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# 8. ỨNG DỤNG FRONTEND (WEB - NEXT.JS)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_APP_NAME="Hệ thống Quản lý Học tập LMS"
